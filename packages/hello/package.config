name=hello
version=1.0.0
description=A tiny window that counts your clicks.
details=The smallest LobsterOS GUI program: one window drawn straight into the shared framebuffer, a greeting and a click counter. Read packages/hello/src/hello.c to see the whole window API in one screen.
category=Utilities
icon=AppWelcome
kind=gui
license=MIT
exec=/apps/hello
build_c=src/hello.c -> /apps/hello
