name=ncc
version=1.0.0
description=Self-hosting C compiler, assembler and linker.
details=The ncc toolchain with its small libc and headers. Compile C on the device with: ncc hello.c. Rebuilt from the prebuilt package that ships in tools/ncc-1.0.0.lobpkg.
category=Developer
icon=AppTerminal
kind=cli
license=MIT
exec=/usr/bin/ncc
import_lobpkg=../../tools/ncc-1.0.0.lobpkg
homepage=https://github.com/ghaerr/ncc
