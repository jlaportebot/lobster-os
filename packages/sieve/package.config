name=sieve
version=1.0.0
description=Prime-counting benchmark for the terminal.
details=Runs the Sieve of Eratosthenes over the first two million integers three times and prints how long each round took. Run it from the Terminal with: sieve
category=Developer
icon=AppSystemMonitor
kind=cli
license=MIT
exec=/apps/sieve
build_c=src/sieve.c -> /apps/sieve
